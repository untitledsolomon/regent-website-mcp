# Copy to .env for local `npm run dev` testing only.
# For actual MCP client usage, set these in the client's server config instead
# (see README.md) — do not commit a real .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required only for send_newsletter / reply_to_consultation tools.
# Create a dedicated Supabase Auth user, grant it the 'admin' role in
# user_roles, and use its credentials here.
REGENT_ADMIN_EMAIL=agent-service-account@yourdomain.com
REGENT_ADMIN_PASSWORD=change-me

# Local dev convenience: when set to 1, the server will accept calls without
# Authorization header (useful when testing with stdio/inspector). Do NOT set
# this in production.
# MCP_ALLOW_LOCAL_NO_AUTH=0
